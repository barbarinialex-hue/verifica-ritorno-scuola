# Configurazione esempio per un database MySQL gestito da Aiven
# Copia questo file in .env e sostituisci i valori reali.

FLASK_APP=run.py
FLASK_DEBUG=0

# Chiavi segrete: usa stringhe lunghe e casuali
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Connection string del database Aiven
# Prendi il valore esatto dal pannello Aiven > Service overview > Connection information
# Esempio:
# DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@mysql-yourservice.aivencloud.com:12345/defaultdb?charset=utf8mb4&ssl=true
DATABASE_URL=mysql+pymysql://avnadmin:CHANGE_ME@HOST:PORT/defaultdb?charset=utf8mb4&ssl=true

# Parametri app
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=16777216
JWT_COOKIE_SECURE=1

# Nota:
# - Non usare questo file come file di lavoro reale.
# - Copialo in .env e riempilo con i dati reali del tuo servizio Aiven.
# - Se Aiven ti fornisce un certificato CA e una connessione SSL dettagliata, usa l'URI esatto che ti propone.
