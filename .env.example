FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Local MySQL example
DATABASE_URL=mysql+pymysql://verifica_user:change-me@127.0.0.1:3306/verifica_ritorno_scuola?charset=utf8mb4
MYSQL_DATABASE=verifica_ritorno_scuola
MYSQL_USER=verifica_user
MYSQL_PASSWORD=use-an-alphanumeric-local-password
MYSQL_ROOT_PASSWORD=use-a-different-local-password
APP_PORT=8000

# Remote Aiven MySQL example:
# DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@HOST:PORT/defaultdb?charset=utf8mb4&ssl=true
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=16777216
JWT_COOKIE_SECURE=0
