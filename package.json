import test from 'node:test';
import assert from 'node:assert/strict';
import request from 'supertest';

import app from '../src/app.js';
import { pool } from '../src/db.js';

const hasDatabaseConfig = Boolean(process.env.DATABASE_URL);

async function ensureQuartiereId() {
  const result = await pool.query(
    `INSERT INTO quartiere (nome_quartiere, cap_zona)
     VALUES ('Quartiere Auth Test', '11111')
     ON CONFLICT (nome_quartiere, cap_zona) DO NOTHING
     RETURNING id;`
  );

  if (result.rows[0]) {
    return result.rows[0].id;
  }

  const existing = await pool.query(
    `SELECT id FROM quartiere WHERE nome_quartiere = 'Quartiere Auth Test' AND cap_zona = '11111';`
  );

  return existing.rows[0].id;
}

test('POST /api/auth/register creates a user with a valid token', { skip: !hasDatabaseConfig }, async () => {
  const quartiereId = await ensureQuartiereId();
  const email = `register.${Date.now()}@example.com`;

  const response = await request(app)
    .post('/api/auth/register')
    .send({
      nome: 'Luca',
      cognome: 'Verdi',
      email,
      password: 'Password123!',
      tipoRuolo: 'Cittadino',
      quartiereId,
    });

  assert.equal(response.status, 201);
  assert.equal(response.body.success, true);
  assert.ok(response.body.token);
  assert.equal(response.body.user.email, email);
  assert.equal(response.body.user.tipoRuolo, 'Cittadino');
});

test('POST /api/auth/login authenticates an existing user', { skip: !hasDatabaseConfig }, async () => {
  const quartiereId = await ensureQuartiereId();
  const email = `login.${Date.now()}@example.com`;

  await request(app)
    .post('/api/auth/register')
    .send({
      nome: 'Anna',
      cognome: 'Neri',
      email,
      password: 'Password123!',
      tipoRuolo: 'MembroComitato',
      quartiereId,
    });

  const response = await request(app)
    .post('/api/auth/login')
    .send({
      email,
      password: 'Password123!',
    });

  assert.equal(response.status, 200);
  assert.equal(response.body.success, true);
  assert.ok(response.body.token);
  assert.equal(response.body.user.email, email);
  assert.equal(response.body.user.tipoRuolo, 'MembroComitato');
});

test('GET /api/auth/me requires a valid bearer token', { skip: !hasDatabaseConfig }, async () => {
  const quartiereId = await ensureQuartiereId();
  const email = `me.${Date.now()}@example.com`;

  const registerResponse = await request(app)
    .post('/api/auth/register')
    .send({
      nome: 'Giulia',
      cognome: 'Rosa',
      email,
      password: 'Password123!',
      tipoRuolo: 'Admin',
      quartiereId,
    });

  const response = await request(app)
    .get('/api/auth/me')
    .set('Authorization', `Bearer ${registerResponse.body.token}`);

  assert.equal(response.status, 200);
  assert.equal(response.body.success, true);
  assert.equal(response.body.user.email, email);
  assert.equal(response.body.user.tipoRuolo, 'Admin');
});

test('POST /api/auth/login rejects wrong password', { skip: !hasDatabaseConfig }, async () => {
  const quartiereId = await ensureQuartiereId();
  const email = `wrong.${Date.now()}@example.com`;

  await request(app)
    .post('/api/auth/register')
    .send({
      nome: 'Paolo',
      cognome: 'Bianchi',
      email,
      password: 'Password123!',
      tipoRuolo: 'Cittadino',
      quartiereId,
    });

  const response = await request(app)
    .post('/api/auth/login')
    .send({
      email,
      password: 'WrongPassword123!',
    });

  assert.equal(response.status, 401);
  assert.equal(response.body.error.code, 'INVALID_CREDENTIALS');
});
